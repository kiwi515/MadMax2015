---
BasedOnStyle: LLVM
Language: Cpp
Standard: Cpp11

AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Empty
ConstructorInitializerAllOnOneLineOrOnePerLine: true
FixNamespaceComments: true
IncludeBlocks: Regroup
IndentWidth: 4
InsertNewlineAtEOF: true
PointerAlignment: Left
ShortNamespaceLines: 0
SortIncludes: "true"
SortUsingDeclarations: "true"
UseTab: Never

IncludeCategories:
  # standard library headers
  - Regex: "<[[:alnum:].]+>"
    Priority: 1
    CaseSensitive: true

  # boost headers
  - Regex: '(<|")boost\/'
    Priority: 2
    CaseSensitive: true

  # ctg/components headers
  - Regex: '(<|")(Animation|Base|GameSystem|Graphics|Input|Physics|Sound|System)\/'
    Priority: 3
    CaseSensitive: true

  # avalanche engine headers
  - Regex: '(<|")AvaCore\/'
    Priority: 4
    CaseSensitive: true

  # mm game code headers
  - Regex: '(<|")(Application|Game|fragments)\/'
    Priority: 5
    CaseSensitive: true

  # all other headers
  - Regex: ".*"
    Priority: 0
